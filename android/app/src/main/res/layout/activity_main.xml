<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bluetooth -->
        <TextView
            android:id="@+id/tvBle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth: disconnected"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connect to MotoNav" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnect" />
        </LinearLayout>

        <!-- Destination (filled by Share from Google Maps) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Destination"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDestName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No destination yet"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvDestInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="In Google Maps: open a place, tap Share, choose MotoNav."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartNav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Start navigation" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />
        </LinearLayout>

        <!-- Live navigation status: what the display is being told right now -->
        <TextView
            android:id="@+id/tvNavStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Not navigating"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Advanced / testing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Advanced / testing"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnInitNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Init Navigation SDK (accept Google terms)" />

        <EditText
            android:id="@+id/etStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start lat,lng (simulation only)"
            android:importantForAutofill="no"
            android:inputType="text"
            android:text="12.9716,77.5946" />

        <EditText
            android:id="@+id/etDest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Destination lat,lng (filled by Share, or type)"
            android:importantForAutofill="no"
            android:inputType="text"
            android:text="12.9352,77.6245" />

        <Switch
            android:id="@+id/swTwoWheeler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Two-wheeler routing" />

        <Button
            android:id="@+id/btnSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simulated route (desk test)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Display test (no Google needed)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Left 300m" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Right 80m" />

            <Button
                android:id="@+id/btnStraight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Straight" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Roundabout 2" />

            <Button
                android:id="@+id/btnUturn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="U-turn" />

            <Button
                android:id="@+id/btnArrive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Arrive" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStopTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop display test" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minHeight="200dp"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
